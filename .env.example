# Copiá este archivo como .env.local para desarrollo, y cargá las mismas variables en Vercel.

# Cadena de conexión de MongoDB Atlas (Database > Connect > Drivers)
MONGODB_URI="mongodb+srv://USUARIO:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority"
# Nombre de la base de datos
MONGODB_DB="turnero"

# Contraseña para entrar al panel /admin
ADMIN_PASSWORD="cambiame-por-una-contraseña-larga"

# Secreto para firmar la sesión del admin. Generalo con: openssl rand -base64 32
AUTH_SECRET="pegá-acá-un-string-aleatorio-de-32-caracteres-o-más"

# URL pública del sitio (para links de turnos). En Vercel: https://tu-dominio.com
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
